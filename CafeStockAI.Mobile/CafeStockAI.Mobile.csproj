  <PropertyGroup><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CafeStockAI.Infrastructure\CafeStockAI.Infrastructure.csproj" />
    <EmbeddedResource Include="..\CafeStockAI.Desktop\Assets\Products\*.png" LogicalName="Mobile.Images.%(Filename)%(Extension)" />
